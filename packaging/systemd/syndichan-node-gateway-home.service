[Unit]
Description=Syndichan dedicated HTTPS gateway
Documentation=https://github.com/Jonathan-R-Anderson/syndichan-node
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/syndichan-node
ExecStart=/home/ubuntu/syndichan-node/bin/syndichan-node -gateway-only -config /home/ubuntu/syndichan-node/config/config.json -data-dir /home/ubuntu/syndichan-node/data
Restart=on-failure
RestartSec=5s
TimeoutStopSec=75s

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/syndichan-node
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
